# Postgres connection. Leave unset to store episodes in a local SQLite file.
# DATABASE_URL=postgres://user:pass@localhost:5432/yixi

# SQLite file used when DATABASE_URL is unset. Default: data/episodes.sqlite
# EPISODE_DB_PATH=data/episodes.sqlite

# Shared studio password. Required for /studio and all write APIs.
# Send it as Authorization: Bearer <password>, Basic (any user, this password),
# or x-studio-key. The browser login stores an HttpOnly cookie instead.
STUDIO_PASSWORD=change-me

# Anonymous POST /api/episodes and /generate stay closed unless this is true.
# ALLOW_PUBLIC_CREATE=true

# Text generation via the OpenAI Agents SDK (server only, never NEXT_PUBLIC_*).
# Real model mode requires both an API key and an explicitly selected model.
# OPENAI_API_KEY=
# AGENT_MODEL=
# Default transport is Responses. Compatible gateways can opt into chat_completions.
# OPENAI_BASE_URL=https://api.openai.com/v1
# AGENT_API=responses
# AGENT_TIMEOUT_MS=120000
# AGENT_MAX_OUTPUT_TOKENS=12000
# Inputs/outputs are not exported through SDK tracing; Responses store=false.
# Model mode fails explicitly if unavailable; template mode never calls a model.

# Podcast TTS is pluggable. Unset or stub does not call a vendor and needs no API key.
# TTS_PROVIDER=stub
# Future adapters, not wired in this slice: elevenlabs | azure | volcengine
# TTS_API_KEY=
# TTS_ENDPOINT=
# TTS_VOICE_HOST=
# TTS_VOICE_GUEST=
# TTS_VOICE_DEFAULT=

# Optional override for podcast drafts. Defaults to EPISODE_DB_PATH, then data/episodes.sqlite.
# PODCAST_DB_PATH=data/episodes.sqlite
